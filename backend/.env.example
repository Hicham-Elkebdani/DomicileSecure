# =============================================================================
# DomicileSecure — backend configuration
# Copy to `.env` and adapt. Never commit `.env`.
# Generate secrets with:  python scripts/generate_secrets.py
# =============================================================================

# --- Application -------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false                     # true in production (one JSON object per line)
TIMEZONE=Africa/Casablanca         # household timezone (night rules, daily summary)
CORS_ORIGINS=["http://localhost:3000"]

# --- Database ----------------------------------------------------------------
# Development: SQLite file, nothing to install.
DATABASE_URL=sqlite+aiosqlite:///./domicilesecure.db
# Production: PostgreSQL
# DATABASE_URL=postgresql+asyncpg://domicile:CHANGE_ME@localhost:5432/domicilesecure

# --- Security ----------------------------------------------------------------
JWT_SECRET_KEY=change-me-with-generate_secrets
ACCESS_TOKEN_EXPIRE_MINUTES=60
WORKER_API_KEY=change-me-with-generate_secrets   # shared by the API and the worker(s)
LOGIN_RATE_LIMIT_PER_MINUTE=5

# --- Face recognition (model 2) ---------------------------------------------
FACE_MATCH_THRESHOLD=0.363         # SFace cosine similarity; higher = stricter
FACE_MIN_DETECTION_SCORE=0.8
SIGHTING_GAP_MINUTES=30            # two sightings closer than this count as one visit
RECURRING_VISITOR_THRESHOLD=3      # visits before suggesting "register as guest"
MAX_UPLOAD_SIZE_MB=5

# --- Anomaly engine (model 3) -----------------------------------------------
ANOMALY_ENGINE=rules               # rules | lstm | hybrid (rules + LSTM, recommended once trained)
NIGHT_START_HOUR=23
NIGHT_END_HOUR=6
DOOR_OPEN_MAX_SECONDS=600
RESIDENT_PRESENCE_MINUTES=30       # a resident seen within this window = someone is home
ALERT_COOLDOWN_MINUTES=10
ANOMALY_TICK_SECONDS=60
LSTM_MODEL_DIR=artifacts/anomaly_lstm/latest

# --- Notifications (Web Push) ------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PUSH_MIN_SEVERITY=medium           # info | low | medium | high | critical

# --- Scheduler ---------------------------------------------------------------
SCHEDULER_ENABLED=true
DAILY_SUMMARY_HOUR=21

# =============================================================================
# Vision worker (one process per camera) — variables prefixed with WORKER_
# =============================================================================
WORKER_API_BASE_URL=http://localhost:8000/api/v1
WORKER_CAMERA_ID=                  # printed by: python -m app.cli create-camera ...
WORKER_CAMERA_SOURCE=0             # webcam index, rtsp://user:pass@ip/stream, or a video file
WORKER_DETECTOR_WEIGHTS=artifacts/vision/yolo11n.pt
WORKER_DETECTOR_CONFIDENCE=0.45
# WORKER_DOOR_MODEL_PATH=artifacts/vision/door_yolo.pt   # after training/finetune_door.py
WORKER_TARGET_FPS=5
WORKER_PREVIEW=false               # true: show a window with detections (development)
# WORKER_DEVICE=cpu                # cpu | cuda:0
